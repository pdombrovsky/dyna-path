{
    "name": "pdombrovsky/dyna-path",
    "type": "library",
    "description": "Shared immutable path value object and parser for Dyna packages",
    "keywords": [
        "path",
        "dynamodb",
        "jmespath",
        "parser"
    ],
    "homepage": "https://github.com/pdombrovsky/dyna-path",
    "license": "MIT",
    "authors": [
        {
            "name": "pdombrovsky",
            "email": "dambrouskip@gmail.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "DynaPath\\": "src/"
        }
    },
    "require": {
        "php": ">=8.2.0",
        "ext-ctype": "*",
        "ext-json": "*"
    },
    "autoload-dev": {
        "psr-4": {
            "DynaPath\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11.4",
        "phpstan/phpstan": "^1.12"
    }
}
